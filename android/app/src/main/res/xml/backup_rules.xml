<?xml version="1.0" encoding="utf-8"?>
<!-- API 30 and below: exclude all app data from auto backup. Mirrors the
     full exclusion in data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
