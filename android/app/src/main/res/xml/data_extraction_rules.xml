<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude all app data from cloud backup and device-to-device transfer.
     allowBackup="false" alone does not stop direct device transfer on
     API 31+, so every data domain is excluded here as well. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
